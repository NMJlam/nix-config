# Ghostty config, managed by the flake (users/nlam/home-manager.nix).
# Docs: https://ghostty.org/docs/config

theme = "Catppuccin Mocha"
# Bar by default; the shell switches it to a block in vi normal mode.
cursor-style = bar
macos-titlebar-style = hidden
window-decoration = true
window-padding-x = 10
window-padding-y = 10

# Quick terminal keybinds
quick-terminal-position=center
quick-terminal-size = 80%, 80%
keybind = global:cmd+backquote=toggle_quick_terminal

clipboard-read = allow
clipboard-write = allow

background-opacity = 0.8
keybind = shift+enter=text:\x1b\r

# no-cursor: let bash readline set the cursor (block in vi normal, bar in insert)
shell-integration-features = no-cursor,ssh-env,ssh-terminfo
keybind = ctrl+left_bracket=text:\x1b
